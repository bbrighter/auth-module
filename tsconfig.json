{
	"compilerOptions": {
		// Type checking
		"strict": true, // Default = true
		// Modules
		"rootDir": "./src",
		"module": "esnext",
		"moduleResolution": "bundler",

		// Interop constraints
		"declaration": false,
		"esModuleInterop": true,

		// Language and environment
		"target": "ESNext",
		"jsx": "react-jsx",

		// Completeness
		"skipLibCheck": true
	},
	"include": ["src/**/*"]
}
