{
  "name": "@bbrighter/auth-module",
  "version": "0.1.1",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/users.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./login": {
      "types": "./dist/login.d.ts",
      "import": "./dist/login.js"
    },
    "./app-bar": {
      "types": "./dist/app-bar.d.ts",
      "import": "./dist/app-bar.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:pack": "tsup && pnpm pack",
    "test": "vitest",
    "test:cover": "test --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc",
    "knip": "knip",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > depcruiser-graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > depcruiser-graph.svg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@vitest/coverage-v8": "^4.0.16",
    "dependency-cruiser": "^17.3.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "knip": "^5.75.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@emotion/react": "11.x",
    "@emotion/styled": "11.x",
    "@mui/icons-material": "7.x",
    "@mui/material": "7.x",
    "react": "19.x"
  }
}